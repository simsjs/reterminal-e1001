<div class="view view--half_horizontal">
  <div class="layout" style="padding: 0">
    <div class="wx" style="padding: 12px 20px 8px; gap: 20px; align-items: center">
    {% if ok != true %}
      {% render "wx_error", error: error %}
    {% else %}
      <div class="wx-col" style="flex: none; gap: 6px">
        <div class="wx-hero" style="margin-top: 0">
          {% render "wx_icon", kind: now.icon, w: 58 %}
          <div class="wx-temp" style="font-size: 60px">{{ now.temp }}<sup>°</sup></div>
        </div>
        <div style="font-size: 16px; font-weight: 700">{{ now.cond }}</div>
        <div class="wx-hl" style="margin-top: 0">H {{ now.hi }} · L {{ now.lo }}</div>
      </div>
      <div class="wx-vrule" style="align-self: stretch"></div>
      <div class="wx-grow" style="display: grid; grid-template-columns: repeat(5, 1fr); text-align: center">
        {% for d in days limit: 5 %}
        <div class="wx-col" style="align-items: center; gap: 4px">
          <span class="wx-label" style="font-size: 12px">{{ d.name }}</span>
          {% render "wx_icon", kind: d.icon, w: 30, cls: "sm" %}
          <span style="font-size: 18px; font-weight: 800">{{ d.hi }}</span>
          <span style="font-size: 14px; font-weight: 600">{{ d.lo }}</span>
        </div>
        {% endfor %}
      </div>
    {% endif %}
    </div>
  </div>
  <div class="title_bar">
    <span class="title">Weather</span>
    <span class="instance">{{ place }}</span>
  </div>
</div>
