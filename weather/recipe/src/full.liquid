<div class="view view--full">
  <div class="wxx">
  {% render "screen_header", title: "WEATHER", device: trmnl.device, cfv: trmnl.plugin_settings.custom_fields_values, pn: page_number, pc: page_count, as_of: as_of %}
  <div class="wxx-body">
    <div class="wx">
    {% if ok != true %}
      {% render "wx_error", error: error %}
    {% elsif scene %}

      <!-- ── 2x2: the house picture | now and the plan, then 5 days | details ── -->
      <div class="wx-col wx-sleft">
        <div class="wx-scene" style="height: {{ scene.h }}px">
          <img src="{{ scene.src }}" width="{{ scene.w }}" height="{{ scene.h }}" alt="">
        </div>
        <div class="wx-col wx-grow" style="padding: 12px 22px 10px 22px">
          <span class="wx-label">Next 5 days</span>
          {% render "wx_days", days: days_short, icon_w: 36 %}
        </div>
      </div>

      <div class="wx-vrule"></div>

      <div class="wx-col wx-grow">
        <div class="wx-col wx-snow" style="height: {{ scene.h }}px">
          <div class="wx-row" style="justify-content: space-between; gap: 10px">
            <span class="wx-label">Now · {{ place }}</span>
            {% if warning %}<span class="wx-tag">Offline</span>{% else %}<span class="wx-label">Feels {{ now.feels }}</span>{% endif %}
          </div>
          {% if alert %}{% assign iw = 58 %}{% assign tf = 68 %}{% else %}{% assign iw = 70 %}{% assign tf = 82 %}{% endif %}
          <div class="wx-hero" style="margin-top: 10px">
            {% render "wx_icon", kind: now.icon, w: iw %}
            <div class="wx-temp" style="font-size: {{ tf }}px">{{ now.temp }}<sup>°</sup></div>
          </div>
          <div class="wx-cond" style="margin-top: 10px">{{ now.cond }}</div>
          <div class="wx-hl">H {{ now.hi }} · L {{ now.lo }}</div>
          {% if alert %}{% render "wx_alert", alert: alert %}{% else %}<div class="wx-plan">{{ now.plan }}</div>{% endif %}
        </div>
        <div class="wx-col wx-grow" style="padding: 12px 20px 10px 20px">
          {% render "wx_details", details: details, cols: 2, skip: "precip", wide: "sun", flush: true %}
        </div>
      </div>

    {% else %}

      <!-- ── Left: right now, the plan or an alert, then the details ─────── -->
      <div class="wx-col wx-left">
        <div class="wx-row" style="justify-content: space-between; gap: 10px">
          <span class="wx-label">Now · {{ place }}</span>
          {% if warning %}<span class="wx-tag">Offline</span>{% else %}<span class="wx-label">Feels {{ now.feels }}</span>{% endif %}
        </div>
        <div class="wx-hero">
          {% render "wx_icon", kind: now.icon, w: 82 %}
          <div class="wx-temp">{{ now.temp }}<sup>°</sup></div>
        </div>
        <div class="wx-cond">{{ now.cond }}</div>
        <div class="wx-hl">H {{ now.hi }} · L {{ now.lo }}</div>
        {% if alert %}{% render "wx_alert", alert: alert %}{% else %}<div class="wx-plan">{{ now.plan }}</div>{% endif %}
        {% render "wx_details", details: details, cols: 2 %}
      </div>

      <div class="wx-vrule"></div>
      {% render "wx_right", h: hourly, days: days, icon_w: 30, day_icon_w: 34 %}

    {% endif %}
    </div>
  </div>
  </div>
</div>
