<div class="view view--full">
  <div class="wxx">
  {% render "wx_header", device: trmnl.device, cfv: trmnl.plugin_settings.custom_fields_values, as_of: as_of %}
  <div class="wxx-body">
    <div class="wx">
    {% if ok != true %}
      {% render "wx_error", error: error %}
    {% elsif scene %}

      <!-- ── Left: a picture of the house for the season and weather, then now and the details ── -->
      <div class="wx-col wx-sleft">
        <div class="wx-scene" style="max-height: {{ scene.h }}px">
          <img src="{{ scene.src }}" width="{{ scene.w }}" height="{{ scene.h }}" alt="">
          {% if warning %}<span class="wx-tag" style="position: absolute; top: 8px; right: 8px; box-shadow: 0 0 0 2px #fff">Offline</span>{% endif %}
        </div>
        <div class="wx-col" style="flex: none; padding: 0 22px 12px 22px">
          <div class="wx-now">
            <div class="wx-temp" style="font-size: 60px">{{ now.temp }}<sup>°</sup></div>
            <div style="min-width: 0">
              <div class="wx-label" style="font-size: 12px">Now · {{ place }}</div>
              <div class="wx-cond" style="font-size: 19px; margin-top: 5px">{{ now.cond }}</div>
              <div class="wx-hl" style="font-size: 12px; margin-top: 5px">H {{ now.hi }} · L {{ now.lo }} · FEELS {{ now.feels }}</div>
            </div>
          </div>
          {% if alert %}{% render "wx_alert", alert: alert %}{% else %}<div class="wx-plan">{{ now.plan }}</div>{% endif %}
          {% render "wx_details", details: details, cols: 3 %}
        </div>
      </div>

      <div class="wx-vrule"></div>
      {% render "wx_right", h: hourly, days: days, icon_w: 26, day_icon_w: 30 %}

    {% else %}

      <!-- ── Left: right now, the plan or an alert, then the details ─────── -->
      <div class="wx-col wx-left">
        <div class="wx-row" style="justify-content: space-between; gap: 10px">
          <span class="wx-label">Now · {{ place }}</span>
          {% if warning %}<span class="wx-tag">Offline</span>{% else %}<span class="wx-label">Feels {{ now.feels }}</span>{% endif %}
        </div>
        <div class="wx-hero">
          {% render "wx_icon", kind: now.icon, w: 82 %}
          <div class="wx-temp">{{ now.temp }}<sup>°</sup></div>
        </div>
        <div class="wx-cond">{{ now.cond }}</div>
        <div class="wx-hl">H {{ now.hi }} · L {{ now.lo }}</div>
        {% if alert %}{% render "wx_alert", alert: alert %}{% else %}<div class="wx-plan">{{ now.plan }}</div>{% endif %}
        {% render "wx_details", details: details, cols: 2 %}
      </div>

      <div class="wx-vrule"></div>
      {% render "wx_right", h: hourly, days: days, icon_w: 30, day_icon_w: 34 %}

    {% endif %}
    </div>
  </div>
  </div>
</div>
