{% assign de_font = trmnl.plugin_settings.custom_fields_values.font_base | default: "http://kitchen-board:8080" %}
<style>
  /* Header row: same look as the calendar and Polestar screens (fonts are served by the kitchen-board container) */
  @font-face { font-family: "KB Mono"; src: url("{{ de_font }}/fonts/SpaceMono-Bold.ttf") format("truetype"); font-weight: 700; }
  @font-face { font-family: "KB Mono"; src: url("{{ de_font }}/fonts/SpaceMono-Regular.ttf") format("truetype"); font-weight: 400; }
  .dex { position: fixed; top: 0; left: 0; z-index: 2147483647; width: 800px; height: 480px; overflow: hidden; background: #fff; color: #000; }
  .dex-body { position: absolute; top: 44px; left: 0; width: 800px; height: 436px; display: flex; }
  .de-hdr { position: absolute; left: 0; top: 0; width: 800px; height: 44px; border-bottom: 3px solid #000; box-sizing: border-box;
    display: flex; align-items: center; padding: 0 21px 0 20px; color: #000; }
  .de-hdr .dots { display: flex; gap: 6px; margin-right: 13px; }
  .de-hdr .dot { width: 10px; height: 10px; border: 2px solid #000; border-radius: 50%; box-sizing: border-box; }
  .de-hdr .dot.on { background: #000; }
  .de-hdr .hdr-title { font: 700 14px/1 "KB Mono", "Courier New", monospace; letter-spacing: 0.8px; }
  .de-hdr .hdr-right { margin-left: auto; display: flex; align-items: center; font: 700 14px/1 "KB Mono", "Courier New", monospace; letter-spacing: 0.8px; }
  .de-hdr .wifi { margin: 0 14px 0 0; width: 21px; height: 16px; }
  .de-hdr .wifi path { fill: none; stroke: #000; stroke-width: 2.6; stroke-linecap: round; }
  .de-hdr .wifi circle { fill: #000; }
  .de-hdr .wifi-2 .w3, .de-hdr .wifi-1 .w3, .de-hdr .wifi-1 .w2 { stroke-width: 1.5; stroke-dasharray: 2 1.8; stroke-linecap: butt; }
  .de-hdr .batt { position: relative; width: 27px; height: 14px; border: 2.5px solid #000; border-radius: 3px; margin-right: 9px; box-sizing: border-box; }
  .de-hdr .batt::after { content: ""; position: absolute; right: -5px; top: 3px; width: 2.5px; height: 4px; background: #000; border-radius: 0 1px 1px 0; }
  .de-hdr .batt-fill { position: absolute; left: 1.5px; top: 1.5px; bottom: 1.5px; background: #000; }

  /* Energy panel: pure black and white so it stays crisp on 1-bit e-ink (gray drops out). */
  .de { box-sizing: border-box; display: flex; width: 100%; height: 100%; color: #000; font-family: "Inter", "Helvetica Neue", Arial, sans-serif; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .de * { box-sizing: border-box; }
  .de-col { display: flex; flex-direction: column; min-width: 0; }
  .de-row { display: flex; align-items: baseline; }
  .de-grow { flex: 1 1 auto; min-width: 0; }
  .de-label { font: 700 13px/1 "KB Mono", "Courier New", monospace; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .de-meta { font-size: 15px; font-weight: 500; white-space: nowrap; }
  .de-big { font-weight: 700; letter-spacing: -0.045em; line-height: 0.8; white-space: nowrap; }
  .de-big small { font-size: 0.3em; letter-spacing: 0; margin-left: 0.12em; font-weight: 600; }
  .de-num { font-weight: 700; letter-spacing: -0.02em; white-space: nowrap; }
  .de-rule { border-top: 2px solid #000; }
  .de-vrule { border-left: 2px solid #000; }
  .de-hatch { background: repeating-linear-gradient(135deg, #000 0 2px, #fff 2px 6px); }

  /* Cycle bar: solid = used so far, hatched = rest of the projection, tick = last bill */
  .de-cbar { position: relative; height: 34px; border: 3px solid #000; border-radius: 8px; padding: 3px; }
  .de-ctrack { position: relative; height: 100%; border-radius: 4px; overflow: hidden; }
  .de-cbar .tick { position: absolute; top: -9px; bottom: -9px; width: 0; border-left: 3px solid #000; }
  .de-cbar .tick::after { content: ""; position: absolute; left: -7px; bottom: -3px; border: 5.5px solid transparent; border-bottom: 7px solid #000; }

  /* Money tiles */
  .de-tiles { display: flex; }
  .de-tiles > div { flex: 1 1 0; min-width: 0; }
  .de-tiles > div + div { border-left: 2px solid #000; padding-left: 12px; }

  /* Half-hour chart */
  .de-chart { position: relative; display: flex; align-items: flex-end; gap: 2px; border-bottom: 2px solid #000; }
  .de-chart .b { flex: 1 1 0; background: #000; }
  .de-chart .b.pk { background: repeating-linear-gradient(0deg, #000 0 3px, #fff 3px 5px); outline: 2px solid #000; outline-offset: -2px; }
  .de-chart .grid { position: absolute; left: 0; right: 0; border-top: 1.5px dashed #000; }
  .de-axis { position: relative; height: 16px; font: 400 11px/1 "KB Mono", "Courier New", monospace; }
  .de-axis span { position: absolute; top: 4px; transform: translateX(-50%); white-space: nowrap; }
  .de-axis span::before { content: ""; position: absolute; left: 50%; top: -6px; height: 4px; border-left: 2px solid #000; }
  .de-peak { position: absolute; top: -2px; font-size: 13px; font-weight: 700; white-space: nowrap; }

  /* Seven-day bars */
  .de-week { position: relative; display: flex; align-items: flex-end; gap: 10px; border-bottom: 2px solid #000; }
  .de-week .wd { flex: 1 1 0; display: flex; flex-direction: column; align-items: stretch; }
  .de-week .v { font-size: 13px; font-weight: 700; text-align: center; margin-bottom: 3px; }
  .de-week .wb { border: 2px solid #000; border-bottom: 0; }
  .de-week .wd.on .wb { background: #000; }
  .de-wdays { display: flex; gap: 10px; margin-top: 4px; }
  .de-wdays span { flex: 1 1 0; text-align: center; font: 400 11px/1 "KB Mono", "Courier New", monospace; }
  .de-wdays span.on { font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }

  .de-alert { display: inline-flex; align-items: center; gap: 6px; background: #000; color: #fff; font-weight: 700; font-size: 13px; padding: 3px 8px; border-radius: 6px; white-space: nowrap; }
  .de-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; }
</style>

{% template de_header %}{% assign pn = cfv.page_number | default: 3 | plus: 0 %}{% assign pc = cfv.page_count | default: 3 | plus: 0 %}{% if pc < pn %}{% assign pc = pn %}{% endif %}{% assign batt = device.percent_charged | default: 0 | round %}{% assign fill = batt | times: 20 | divided_by: 100 | round %}{% assign ws = device.wifi_strength | default: 3 %}{% if ws >= 3 %}{% assign wc = "wifi-3" %}{% elsif ws == 2 %}{% assign wc = "wifi-2" %}{% else %}{% assign wc = "wifi-1" %}{% endif %}
<div class="de-hdr">
  <div class="dots">{% for i in (1..pc) %}<div class="dot{% if i == pn %} on{% endif %}"></div>{% endfor %}</div>
  <div class="hdr-title">HOME · ENERGY</div>
  <div class="hdr-right">
    <svg class="wifi {{ wc }}" viewBox="0 0 21 16"><path class="w3" d="M1.6 5.6a12.6 12.6 0 0 1 17.8 0"/><path class="w2" d="M4.6 8.7a8.3 8.3 0 0 1 11.8 0"/><circle cx="10.5" cy="13.2" r="2.1"/></svg>
    <div class="batt"><div class="batt-fill" style="width:{{ fill }}px"></div></div>
    <span>{{ batt }}%</span>
  </div>
</div>
{% endtemplate %}

{% template de_cbar %}<div class="de-cbar"><div class="de-ctrack"><div style="position: absolute; left: 0; top: 0; bottom: 0; width: {{ c.pct_used }}%; background: #000"></div>{% if c.pct_pace > c.pct_used %}<div class="de-hatch" style="position: absolute; top: 0; bottom: 0; left: {{ c.pct_used }}%; width: {{ c.pct_pace | minus: c.pct_used }}%"></div>{% endif %}</div>{% if c.pct_last %}<div class="tick" style="left: calc(3px + (100% - 6px) * {{ c.pct_last }} / 100)"></div>{% endif %}</div>{% endtemplate %}

{% template de_error %}
<div class="de-empty">
  <svg viewBox="0 0 24 24" width="64" height="64"><path d="M12 1.5 0.8 21.5h22.4zM10.8 8.5h2.4l-.3 7h-1.8zm1.2 8.8a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z" fill-rule="evenodd"/></svg>
  <div class="de-num" style="font-size: 30px">No Dominion data yet</div>
  <div class="de-meta" style="max-width: 560px; white-space: normal">{% if error %}{{ error | truncate: 140 }}{% else %}Check that dominion-bridge is running and the Bridge URL and token are set in this recipe.{% endif %}</div>
</div>
{% endtemplate %}
