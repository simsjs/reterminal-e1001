<div class="view view--quadrant">
  <div class="layout" style="padding: 0">
    <div class="ps" style="padding: 8px 16px 6px">
    {% assign du = dist_unit | default: "mi" %}
    {% if car_count == 0 or cars == empty or cars == nil %}
      <div class="ps-empty"><div class="ps-name" style="font-size: 22px">No Polestar data</div></div>
    {% else %}
      {% render "ps_card", car: cars[0], du: du, size: "sm" %}
    {% endif %}
    </div>
  </div>
  <div class="title_bar">
    <span class="title">Polestar</span>
    <span class="instance">{% if updated %}{{ updated }}{% endif %}</span>
  </div>
</div>
