.env
__pycache__/
*.pyc

# Your own images for the Polestar screen stay on the Pi, out of git.
polestar/images/*
!polestar/images/README.md
!polestar/images/cars/
polestar/images/cars/*
!polestar/images/cars/.gitkeep

# The logo for the home energy screen stays on the Pi, out of git.
dominion/images/*
!dominion/images/README.md

# The house pictures for the weather screen stay on the Pi, out of git.
weather/images/*
!weather/images/README.md
