# Copy to .env (which git ignores) and fill in. Never commit .env.

# --- LaraPaper ---
# Reuse the APP_KEY from your original ~/larapaper/docker-compose.yml so
# existing logins and data keep working.
APP_KEY=
# Your Pi's reserved IP, port 4567, no trailing slash.
APP_URL=http://192.168.1.50:4567

# --- Calendar screens (kitchen-board service) ---
TZ=America/New_York
# Weather location (Fairfax, VA by default). Also used by the weather screen.
WEATHER_LAT=38.8462
WEATHER_LON=-77.3064

# Private iCal links, comma-separated.
# Google Calendar: Settings → your calendar → "Secret address in iCal format".
# Leave both empty to see a sample week.
CALENDAR_ICS_URLS=
# Calendars that should only appear on the morning brief (e.g. work).
BRIEF_ONLY_ICS_URLS=
# Reminders on This Week, from Google Tasks. Get the first three values with
# kitchen-board/tools/get_tasks_token.py (see the README). Leave them empty to
# use the reminders list in content.yml instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TASKS_REFRESH_TOKEN=
# Task lists to show, by name, comma-separated. Empty = all lists.
TASKS_LISTS=
# Show tasks due within this many days. Overdue tasks always show.
TASKS_DAYS_AHEAD=7
# on = also show tasks with no due date.
TASKS_INCLUDE_UNDATED=off
# Morning Brief is paused. on = count it in the header dots again (and add it
# back to a playlist in LaraPaper).
BRIEF_ENABLED=off
# Page dots in the calendar screens' header: This Week + Polestar + home energy + fitness + weather.
# Add 1 if you turn Morning Brief back on.
KB_PAGE_COUNT=5

# --- Polestar status screen ---
# Your Polestar ID login (the one for the Polestar app). Stays on the Pi.
POLESTAR_USERNAME=
POLESTAR_PASSWORD=
# Shared secret the Polestar recipe sends. Letters, digits, - and _ only. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POLESTAR_BRIDGE_TOKEN=
# Nicknames and order, by the last 4 characters of each VIN: top car first.
POLESTAR_CAR_NAMES=1234=Snow,5678=Midnight
# 1 = show two fake cars (no login needed), handy for a first look.
POLESTAR_DEMO=0
# Usable battery size per car (last 4 of the VIN), used when the bridge works out efficiency
# itself. Defaults: Polestar 2 = 75, Polestar 3 = 107, Polestar 4 = 94 kWh.
POLESTAR_BATTERY_KWH=

# --- Home energy screen (Dominion Energy) ---
# No password here: you log in once with the dompower tool and the bridge keeps the
# tokens in a Docker volume. See dominion/README.md.
# Shared secret the Home Energy Consumption recipe sends. Make one the same way as the Polestar one.
DOMINION_BRIDGE_TOKEN=
# Optional: pin an account/meter. Normally picked with `dompower select-account`.
DOMINION_ACCOUNT=
DOMINION_METER=
# How often to check Dominion, in minutes. Meter data only updates about once a day.
DOMINION_REFRESH_MINUTES=120
# 1 = show sample data (no login needed), handy for a first look.
DOMINION_DEMO=0

# --- Fitness screen (Strava) ---
# From strava/tools/get_strava_token.py (see strava/README.md).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# Shared secret the Fitness recipe sends. Make one the same way as the Polestar one.
STRAVA_BRIDGE_TOKEN=
# How often to check Strava, in minutes.
STRAVA_REFRESH_MINUTES=15
# Strava sport types that count as strength, and words in a title that make an
# activity a ruck (also counted as strength).
STRAVA_STRENGTH_TYPES=WeightTraining,Workout,Crossfit,HIIT
STRAVA_RUCK_WORDS=ruck
# 1 = show made-up data (no sign-in needed), handy for a first look.
# STRAVA_DEMO_LAYOUT picks the left side: ride, route or effort.
STRAVA_DEMO=0
STRAVA_DEMO_LAYOUT=ride

# --- Weather screen ---
# Uses WEATHER_LAT and WEATHER_LON above. No account or API key needed.
# The place name shown on the screen.
WEATHER_PLACE=Fairfax
# Optional shared secret the Weather recipe sends. Weather isn't private, so you can leave it empty.
WEATHER_BRIDGE_TOKEN=
# How often to check the forecast, in minutes.
WEATHER_REFRESH_MINUTES=15
# off = skip National Weather Service watches and warnings.
WEATHER_ALERTS=on
# 1 = show made-up data (no internet needed), handy for a first look.
WEATHER_DEMO=0
