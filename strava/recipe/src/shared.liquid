{% comment %} ==== BEGIN shared header: copied from shared/ by tools/build-recipes.sh. Edit it there, not here. ==== {% endcomment %}
{% assign kbh_font = trmnl.plugin_settings.custom_fields_values.font_base | default: "http://kitchen-board:8080" %}
<style>
  /* Fonts are served by the kitchen-board container. */
  @font-face { font-family: "KB Mono"; src: url("{{ kbh_font }}/fonts/SpaceMono-Regular.ttf") format("truetype"); font-weight: 400; }
  @font-face { font-family: "KB Mono"; src: url("{{ kbh_font }}/fonts/SpaceMono-Bold.ttf") format("truetype"); font-weight: 700; }
  /* Screen header: page dots, title, Wi-Fi and battery. Shared by every screen.
     This is the only place to change how the header looks. After editing, run
     tools/build-recipes.sh, which copies it into the four recipes and into the
     calendar service. (e-ink is 1-bit, so everything is pure black or white.) */
  .kbh { position: absolute; left: 0; top: 0; width: 800px; height: 44px; border-bottom: 3px solid #000; box-sizing: border-box;
    display: flex; align-items: center; padding: 0 21px 0 20px; color: #000; }
  .kbh * { box-sizing: border-box; }
  .kbh .dots { display: flex; gap: 6px; margin-right: 13px; }
  .kbh .dot { width: 10px; height: 10px; border: 2px solid #000; border-radius: 50%; }
  .kbh .dot.on { background: #000; }
  .kbh .hdr-title { font: 700 14px/1 "KB Mono", "Courier New", monospace; letter-spacing: 0.8px; }
  .kbh .hdr-right { margin-left: auto; display: flex; align-items: center; font: 700 14px/1 "KB Mono", "Courier New", monospace; letter-spacing: 0.8px; }
  .kbh .upd { margin-right: 14px; }
  .kbh .wifi { margin: 0 14px 0 0; width: 21px; height: 16px; }
  .kbh .wifi path { fill: none; stroke: #000; stroke-width: 2.6; stroke-linecap: round; }
  .kbh .wifi circle { fill: #000; }
  /* Unlit bars: a thin dotted arc, since gray drops out on e-ink. */
  .kbh .wifi-2 .w3, .kbh .wifi-1 .w3, .kbh .wifi-1 .w2 { stroke-width: 1.5; stroke-dasharray: 2 1.8; stroke-linecap: butt; }
  .kbh .batt { position: relative; width: 27px; height: 14px; border: 2.5px solid #000; border-radius: 3px; margin-right: 9px; }
  .kbh .batt::after { content: ""; position: absolute; right: -5px; top: 3px; width: 2.5px; height: 4px; background: #000; border-radius: 0 1px 1px 0; }
  .kbh .batt-fill { position: absolute; left: 1.5px; top: 1.5px; bottom: 1.5px; background: #000; }
</style>

{% comment %}
  The header row. full.liquid renders "screen_header" with title, device
  (trmnl.device), cfv (the recipe's custom field values), pn: page_number,
  pc: page_count and, optionally, as_of. pn / pc come from the bridge's data (worked out from SCREEN_ORDER). If an
  older bridge doesn't send them, the recipe's "Page dot" and "Total pages"
  settings are used instead. as_of is optional.
{% endcomment %}
{% template screen_header %}{% assign pn = pn | default: cfv.page_number | default: 1 | plus: 0 %}{% assign pc = pc | default: cfv.page_count | default: pn | plus: 0 %}{% if pc < pn %}{% assign pc = pn %}{% endif %}{% assign batt = device.percent_charged | default: 0 | round %}{% assign fill = batt | times: 20 | divided_by: 100 | round %}{% comment %} LaraPaper reports Wi-Fi as bars, 0-3. {% endcomment %}{% assign ws = device.wifi_strength | default: 3 %}{% if ws >= 3 %}{% assign wc = "wifi-3" %}{% elsif ws == 2 %}{% assign wc = "wifi-2" %}{% else %}{% assign wc = "wifi-1" %}{% endif %}
<div class="kbh">
  <div class="dots">{% for i in (1..pc) %}<div class="dot{% if i == pn %} on{% endif %}"></div>{% endfor %}</div>
  <div class="hdr-title">{{ title }}</div>
  <div class="hdr-right">
    {% if as_of %}<span class="upd">UPDATED {{ as_of | upcase }}</span>{% endif %}
    <svg class="wifi {{ wc }}" viewBox="0 0 21 16"><path class="w3" d="M1.6 5.6a12.6 12.6 0 0 1 17.8 0"/><path class="w2" d="M4.6 8.7a8.3 8.3 0 0 1 11.8 0"/><circle cx="10.5" cy="13.2" r="2.1"/></svg>
    <div class="batt"><div class="batt-fill" style="width:{{ fill }}px"></div></div>
    <span>{{ batt }}%</span>
  </div>
</div>
{% endtemplate %}
{% comment %} ==== END shared header ==== {% endcomment %}
<style>
  .fxx { position: fixed; top: 0; left: 0; z-index: 2147483647; width: 800px; height: 480px; overflow: hidden; background: #fff; color: #000; }
  .fxx-body { position: absolute; top: 44px; left: 0; width: 800px; height: 436px; display: flex; }

  /* Fitness panel: pure black and white so it stays crisp on 1-bit e-ink (gray drops out). */
  .fx { box-sizing: border-box; display: flex; width: 100%; height: 100%; color: #000; font-family: "Inter", "Helvetica Neue", Arial, sans-serif; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .fx * { box-sizing: border-box; }
  .fx-col { display: flex; flex-direction: column; min-width: 0; }
  .fx-row { display: flex; align-items: baseline; }
  .fx-grow { flex: 1 1 auto; min-width: 0; }
  .fx-label { font: 700 13px/1 "KB Mono", "Courier New", monospace; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .fx-mono { font-family: "KB Mono", "Courier New", monospace; }
  .fx-vrule { border-left: 2px solid #000; }

  /* Left: the latest activity */
  .fx-left { flex: none; width: 470px; gap: 10px; padding: 18px 22px 14px 22px; }
  .fx-title { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fx-sub { font-size: 15px; font-weight: 500; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fx-tiles { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; border: 2px solid #000; border-radius: 6px; }
  .fx-tiles > div { padding: 9px 10px 8px; min-width: 0; }
  .fx-tiles > div + div { border-left: 2px solid #000; }
  .fx-tiles .big { font-size: 29px; font-weight: 800; line-height: 1; letter-spacing: -0.035em; white-space: nowrap; }
  .fx-tiles .big small { font-size: 15px; font-weight: 700; letter-spacing: 0; margin-left: 4px; }
  .fx-tiles .cap { font-size: 12px; font-weight: 600; margin-top: 4px; white-space: nowrap; }
  .fx-extras { display: flex; gap: 16px; font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; }
  .fx-best { display: grid; grid-template-columns: repeat(4, 1fr); }
  .fx-best > div + div { border-left: 2px solid #000; padding-left: 10px; }
  .fx-best .k { font-size: 12px; font-weight: 600; }
  .fx-best .v { font-size: 20px; font-weight: 800; }
  .fx-best .v small { font-size: 12px; font-weight: 600; margin-left: 3px; }
  .fx-laps { display: flex; align-items: flex-end; gap: 2px; border-bottom: 2px solid #000; }
  .fx-laps > div { background: #000; }
  .fx-map { position: relative; border: 2px solid #000; border-radius: 6px; overflow: hidden; }
  .fx-map svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fx-split { display: flex; justify-content: space-between; font-size: 15px; font-weight: 600; border-bottom: 1px solid #000; padding-bottom: 3px; }
  .fx-ticks { position: relative; height: 14px; font: 400 11px/1 "KB Mono", "Courier New", monospace; }
  .fx-ticks span { position: absolute; top: 3px; white-space: nowrap; }

  /* Right: hours per week */
  .fx-right { flex: 1 1 auto; padding: 18px 22px 12px 20px; }
  .fx-wk { display: flex; flex-direction: column; gap: 3px; padding: 5px 0 5px; border-bottom: 2px solid #000; }
  .fx-wk-head { display: flex; align-items: center; gap: 8px; }
  .fx-wk-head svg { flex: none; }
  .fx-wk-name { font-size: 16px; font-weight: 700; }
  .fx-wk-now { margin-left: auto; font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
  .fx-wk-now small { font-size: 13px; font-weight: 600; margin-left: 2px; }
  .fx-wk-avg { font-size: 13px; font-weight: 600; width: 34px; text-align: right; }
  .fx-wk-bars { display: flex; gap: 5px; align-items: flex-end; }
  .fx-wk-bars > div { flex: 1 1 0; display: flex; flex-direction: column; justify-content: flex-end; align-items: stretch; }
  .fx-wk-bars .v { font: 700 10px/1 "KB Mono", "Courier New", monospace; text-align: center; margin-bottom: 2px; letter-spacing: -0.02em; }
  .fx-wk-bars .b { width: 100%; background: #000; }
  .fx-wk-bars .b.now { background: repeating-linear-gradient(135deg, #000 0 2px, #fff 2px 6px); border: 2px solid #000; border-bottom: 0; }
  .fx-wk-labels { display: flex; gap: 5px; margin-top: 5px; }
  .fx-wk-labels span { flex: 1 1 0; text-align: center; font: 400 11px/1 "KB Mono", "Courier New", monospace; }
  .fx-wk-labels span.on { font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }
  .fx-pill { margin-top: auto; background: #000; color: #fff; border-radius: 24px; height: 46px; padding: 0 22px; display: flex; align-items: center; justify-content: space-between; }
  .fx-pill .fx-label { color: #fff; }
  .fx-pill b { font-size: 18px; font-weight: 800; }

  .fx-alert { display: inline-flex; align-items: center; background: #000; color: #fff; font-weight: 700; font-size: 12px; padding: 2px 7px; border-radius: 6px; white-space: nowrap; }
  .fx-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; }
</style>

{% template fx_icon %}{% if name == "total" %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2"/><path d="M9 2h6"/></svg>{% elsif name == "cycling" %}<svg width="22" height="20" viewBox="0 0 26 24" fill="none" stroke="#000" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="16" r="4.5"/><circle cx="20.5" cy="16" r="4.5"/><path d="M5.5 16l4.5-8h7l3.5 8"/><path d="M10 8l3.5 8h-8"/><path d="M8.5 5h3.5"/><path d="M17 8l-1-3h2.5"/></svg>{% elsif name == "running" %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="15" cy="4" r="2"/><path d="M7 21l3.5-6 3.5 2.5V22"/><path d="M10.5 15l1.5-7 4.5 4H20"/><path d="M12 8l-4.5 1.5L6 13"/></svg>{% else %}<svg width="22" height="20" viewBox="0 0 26 24" fill="none" stroke="#000" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12h10"/><rect x="4.5" y="6" width="3.5" height="12" rx="1"/><rect x="18" y="6" width="3.5" height="12" rx="1"/><path d="M1.5 9.5v5"/><path d="M24.5 9.5v5"/></svg>{% endif %}{% endtemplate %}

{% template fx_tiles %}<div class="fx-tiles">{% for t in tiles %}<div><div class="big">{{ t.big }}{% if t.unit != "" %}<small>{{ t.unit }}</small>{% endif %}</div><div class="cap">{{ t.cap }}</div></div>{% endfor %}</div>{% endtemplate %}

{% template fx_hr %}
<div class="fx-col" style="margin-top: auto; gap: 4px">
  <div class="fx-row" style="justify-content: space-between"><span class="fx-label">{{ hr.label }}</span><span style="font-size: 13px; font-weight: 700">▲ {{ hr.peak }}</span></div>
  <svg width="100%" height="{{ hr.h }}" viewBox="0 0 {{ hr.w }} {{ hr.h }}" preserveAspectRatio="none" style="display: block; border-bottom: 2px solid #000"><line x1="0" y1="{{ hr.guide_y }}" x2="{{ hr.w }}" y2="{{ hr.guide_y }}" stroke="#000" stroke-width="1.5" stroke-dasharray="4 4"/><path d="{{ hr.path }}" fill="#000"/></svg>
  <div class="fx-mono" style="position: relative; height: 0"><span style="position: absolute; left: 2px; top: -{{ hr.h | minus: hr.guide_y | plus: 18 }}px; font-size: 11px; font-weight: 700; background: #fff; padding: 0 3px">{{ hr.guide }}</span></div>
  <div class="fx-ticks">{% for t in hr.ticks %}<span style="{% if forloop.last %}right: 0{% elsif forloop.first %}left: 0{% else %}left: {{ t.pct }}%; transform: translateX(-50%){% endif %}">{{ t.t }}</span>{% endfor %}</div>
</div>
{% endtemplate %}

{% template fx_error %}
<div class="fx-empty">
  <svg viewBox="0 0 24 24" width="64" height="64"><path d="M12 1.5 0.8 21.5h22.4zM10.8 8.5h2.4l-.3 7h-1.8zm1.2 8.8a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z" fill-rule="evenodd"/></svg>
  <div style="font-size: 30px; font-weight: 700">No Strava data yet</div>
  <div style="font-size: 15px; font-weight: 500; max-width: 560px">{% if error %}{{ error | truncate: 140 }}{% else %}Check that strava-bridge is running and the Bridge URL and token are set in this recipe.{% endif %}</div>
</div>
{% endtemplate %}
