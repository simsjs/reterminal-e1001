<div class="view view--half_vertical">
  <div class="layout" style="padding: 0">
    <div class="fx fx-col" style="padding: 12px 18px 8px; gap: 10px">
    {% if ok != true or last == nil %}
      {% render "fx_error", error: error %}
    {% else %}
      <span class="fx-label">{{ last.label }}</span>
      <div class="fx-title" style="font-size: 22px">{{ last.title }}</div>
      {% for t in last.tiles limit: 4 %}
      <div class="fx-row" style="justify-content: space-between; border-bottom: 2px solid #000; padding-bottom: 4px"><span style="font-size: 14px; font-weight: 600">{{ t.cap }}</span><span style="font-size: 26px; font-weight: 800">{{ t.big }}<small style="font-size: 13px; margin-left: 3px">{{ t.unit }}</small></span></div>
      {% endfor %}
    {% endif %}
    </div>
  </div>
  <div class="title_bar">
    <span class="title">Fitness</span>
    <span class="instance">{% if weeks %}{{ weeks.rows[0].now }} h this week{% endif %}</span>
  </div>
</div>
